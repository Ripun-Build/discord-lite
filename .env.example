# Copy to .env and replace every value. .env is git-ignored — never commit it.

POSTGRES_DB=discordlite
POSTGRES_USER=discordlite
POSTGRES_PASSWORD=change-me

REDIS_PASSWORD=change-me

S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me-too

# Server secrets: long random strings, e.g. `openssl rand -hex 32`.
JWT_SECRET=change-me
CODE_PEPPER=change-me

# Optional: path to a Firebase service-account JSON key, for push notifications.
# Keep the key outside any git repository. Leave empty to disable push.
FIREBASE_SERVICE_ACCOUNT=
